# === Required ===
SERPER_API_KEY=your_serper_api_key_here

# === Recommended ===
JINA_API_KEY=your_jina_api_key_here

# === Output ===
# Root directory for all project data (default: ./output)
OUTPUT_DIR=./output

# === Proxy (optional) ===
# Enable if YouTube transcript extraction gets IP-blocked.
# Most users outside China can leave this disabled.
USE_PROXY=false

# --- Tagged rotating proxy (e.g. 青果网络 Qingguo) ---
# Format: http://user:pass:channel:ttl@host:port
# TUNNEL_HOST=overseas.tunnel.qg.net
# TUNNEL_PORT=16660
# TUNNEL_USER=your_username
# TUNNEL_PASS=your_password
# TUNNEL_PROXY_FORMAT=tagged
# TUNNEL_CHANNEL_PREFIX=channel
# TUNNEL_TTL=60

# --- Standard HTTP proxy ---
# TUNNEL_HOST=proxy.example.com
# TUNNEL_PORT=8080
# TUNNEL_USER=your_username
# TUNNEL_PASS=your_password
# TUNNEL_PROXY_FORMAT=standard

# --- Per-stage control (overrides USE_PROXY) ---
# Leave empty to follow USE_PROXY setting.
# USE_PROXY_FOR_SEARCH=true
# USE_PROXY_FOR_EXTRACT=true

# === LLM API (generate + translate) ===
# Required for `seoscout generate` and `seoscout translate`.
# Any OpenAI-compatible API endpoint works.
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE_URL=https://api.apifast.tech/v1
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=24576
LLM_TIMEOUT=300
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_DELAY=5

# === Generate concurrency ===
# Number of articles to generate in parallel per batch
GENERATE_BATCH_SIZE=100
# Max concurrent API requests for generation
GENERATE_CONCURRENT_LIMIT=10

# === Translate concurrency ===
# Number of translations per batch
TRANSLATE_BATCH_SIZE=10
# Seconds to wait between batches
TRANSLATE_BATCH_DELAY=1

# === YouTube Tuning ===
# Number of videos to fetch per keyword
YOUTUBE_INITIAL_SEARCH_RESULTS=2
# Max videos to keep after filtering
YOUTUBE_MAX_RESULTS_AFTER_FILTER=1
# Skip videos longer than this (seconds)
YOUTUBE_MAX_DURATION=3600
# How many transcripts to extract per keyword
YOUTUBE_EXTRACT_TOP_K=1
# Parallel search workers
YOUTUBE_SEARCH_WORKERS=10
# Parallel transcript extraction workers
YOUTUBE_TRANSCRIPT_WORKERS=15

# === Web Tuning ===
# Google results per keyword
WEB_SEARCH_TOP_N=10
# How many pages to extract per keyword
WEB_EXTRACT_TOP_K=1
# Serper API concurrency
WEB_SEARCH_CONCURRENCY=5
# Jina Reader rate limit (requests per minute)
JINA_RPM=200
# Jina Reader concurrency
JINA_CONCURRENCY=20
# Web extraction retries
WEB_EXTRACT_RETRIES=3

# === General ===
SEARCH_MAX_RETRIES=3
SEARCH_RETRY_DELAY=2
# Domains to exclude from web search results
BLOCKED_DOMAINS=youtube.com,youtu.be,reddit.com,discord.com
