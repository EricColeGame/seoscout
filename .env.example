# === Required ===
SERPER_API_KEY=your_serper_api_key_here

# === Recommended ===
JINA_API_KEY=your_jina_api_key_here

# === Output ===
# Root directory for all project data (default: ./output)
OUTPUT_DIR=./output

# === Proxy (optional) ===
# Most users can leave these disabled.
# Enable if YouTube transcript extraction gets IP-blocked.
USE_PROXY=false
# TUNNEL_HOST=
# TUNNEL_PORT=18866
# TUNNEL_USER=
# TUNNEL_PASS=
# TUNNEL_PROXY_FORMAT=standard
# TUNNEL_CHANNEL_PREFIX=channel
# TUNNEL_TTL=60
# USE_PROXY_FOR_SEARCH=
# USE_PROXY_FOR_EXTRACT=

# === YouTube Tuning ===
# Number of videos to fetch per keyword
YOUTUBE_INITIAL_SEARCH_RESULTS=2
# Max videos to keep after filtering
YOUTUBE_MAX_RESULTS_AFTER_FILTER=1
# Skip videos longer than this (seconds)
YOUTUBE_MAX_DURATION=3600
# How many transcripts to extract per keyword
YOUTUBE_EXTRACT_TOP_K=1
# Parallel search workers
YOUTUBE_SEARCH_WORKERS=10
# Parallel transcript extraction workers
YOUTUBE_TRANSCRIPT_WORKERS=15

# === Web Tuning ===
# Google results per keyword
WEB_SEARCH_TOP_N=10
# How many pages to extract per keyword
WEB_EXTRACT_TOP_K=1
# Serper API concurrency
WEB_SEARCH_CONCURRENCY=5
# Jina Reader rate limit (requests per minute)
JINA_RPM=200
# Jina Reader concurrency
JINA_CONCURRENCY=20
# Web extraction retries
WEB_EXTRACT_RETRIES=3

# === General ===
SEARCH_MAX_RETRIES=3
SEARCH_RETRY_DELAY=2
# Comma-separated list of categories to skip from keywords file
# IGNORED_CATEGORIES=
# Domains to exclude from web search results
BLOCKED_DOMAINS=youtube.com,youtu.be,reddit.com,discord.com
